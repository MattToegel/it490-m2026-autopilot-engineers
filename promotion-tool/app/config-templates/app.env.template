# app/.env.template  (App role)  -  ns87 (Noaman Shahid), Person B
# ----------------------------------------------------------------------------
# This TEMPLATE documents the config keys the App VM needs. It carries NO real
# secrets. Each lane keeps its own real app/.env (NOT in Git, NOT promoted),
# filled with that lane's values. Only this template travels between lanes.
#
# App -> RabbitMQ connection (the App VM talks to MQ, never to MySQL directly).

RABBITMQ_HOST=__SET_PER_LANE__
RABBITMQ_PORT=5672
RABBITMQ_USER=__SET_PER_LANE__
RABBITMQ_PASSWORD=__SET_PER_LANE__
RABBITMQ_VHOST=/
